{
    "name": "atannex/localization",
    "description": "Complete localization for Laravel: locale registry with a built-in catalog, request negotiation (URL prefix, domain, query, user, session, cookie, Accept-Language, geo), localized URLs and hreflang, a language switcher, translatable Eloquent attributes with driver-aware JSON queries, locale-aware formatting, queue locale propagation, missing-key tracking, translation coverage tooling and a Filament plugin.",
    "keywords": [
        "laravel",
        "localization",
        "i18n",
        "l10n",
        "locale",
        "translation",
        "translatable",
        "hreflang",
        "multilingual",
        "filament"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atanga Leke Collins",
            "email": "atangageihlekecollins@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/translation": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-intl": "Native number, currency, list and language-name formatting in every locale.",
        "filament/filament": "For Atannex\\Localization\\Filament\\LocalizationPlugin (^4.0)."
    },
    "autoload": {
        "psr-4": {
            "Atannex\\Localization\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\Localization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\Localization\\LocalizationServiceProvider"
            ],
            "aliases": {
                "Localization": "Atannex\\Localization\\Facades\\Localization"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
